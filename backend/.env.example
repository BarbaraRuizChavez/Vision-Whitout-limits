PORT=4000

# Configuración de PostgreSQL
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=vision_without_limits

# Origen permitido para CORS (URL del frontend)
CORS_ORIGIN=http://localhost:5173

# Clave secreta para firmar las sesiones (JWT). Genera una propia y única,
# nunca uses esta de ejemplo en producción. En Windows con PowerShell:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=escribe_aqui_una_clave_larga_y_aleatoria

# Client ID de Google (para "Iniciar sesión con Google"). Se obtiene en
# https://console.cloud.google.com/apis/credentials — crea credenciales
# tipo "ID de cliente de OAuth" para "Aplicación web". Debe ser EL MISMO
# valor que VITE_GOOGLE_CLIENT_ID en frontend/.env.
GOOGLE_CLIENT_ID=504623995351-4meu83rrh22h15v38gol626q21srmv8a.apps.googleusercontent.com
